    {
      "parameters": {
        "jsCode": "const jobs = $input.all().map(item => item.json);\n\nconst rows = jobs.map(j => `\n  <tr>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\"><strong>${j.score}/10</strong></td>\n    <td style=\"padding:8px;border-bottom:1px solid #eee;\">\n      <a href=\"${j.url}\">${j.title}</a><br/>\n      <span style=\"color:#666;\">${j.company} · ${j.location}</span><br/>\n      <span style=\"color:#888;font-size:12px;\">${j.reason}</span>\n    </td>\n  </tr>`).join('');\n\nconst html = `\n  <h2>Your AI Internship Hunter — ${$now.toFormat('yyyy-MM-dd')}</h2>\n  <p>${jobs.length} good match${jobs.length === 1 ? '' : 'es'} found today.</p>\n  <table style=\"border-collapse:collapse;width:100%;\">\n    ${rows}\n  </table>\n`;\n\nreturn [{ json: { html, count: jobs.length } }];"
      },
