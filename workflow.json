    {
      "parameters": {
        "jsCode": "const profile = $('My Profile1').first().json;\nconst keywords = String(profile.keywords || '')\n  .split(',')\n  .map(k => k.trim().toLowerCase())\n  .filter(Boolean);\n\nconst escapeRe = s => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst patterns = keywords.map(k => ({\n  k,\n  re: new RegExp(`(^|[^a-z0-9])${escapeRe(k)}([^a-z0-9]|$)`, 'i'),\n}));\n\nconst seen = new Set();\nconst kept = [];\n\nfor (const item of $input.all()) {\n  const job = item.json;\n  if (!job.url || !job.title || seen.has(job.url)) continue; // broken or duplicate\n  seen.add(job.url);\n\n  const text = `${job.title} ${job.tags} ${job.description}`;\n  const hits = patterns.filter(p => p.re.test(text)).map(p => p.k);\n\n  if (hits.length > 0) {\n    kept.push({\n      json: {\n        ...job,\n        keyword_hits: hits.length,\n        keywords_found: hits.join(', '),\n      },\n    });\n  }\n}\n\nkept.sort((a, b) => b.json.keyword_hits - a.json.keyword_hits);\n\nreturn kept.slice(0, Number(profile.max_jobs_for_ai) || 20);"
      },
      "id": "smart-filter",
      "name": "Smart Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-300, 260]
    },
    {
      "parameters": {
        "jsCode": "// PACK — turn N job items into ONE item, so the AI scores all jobs in ONE request\n// (free Gemini keys allow ~10 requests/minute — 1 call is faster and never hits the limit)\nconst jobs = $input.all().map((item, index) => ({ id: index, ...item.json }));\n\nconst jobs_text = jobs\n  .map(j => `[${j.id}] ${j.title} @ ${j.company}\\nSource: ${j.source} |\\n${j.description}`)\n  .join('\\n\\n---\\n\\n');\n\nreturn [{ json: { count: jobs.length, jobs, jobs_text } }];"
      },
      "id": "pack-jobs-for-ai",
      "name": "Pack Jobs for AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-80, 260]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=CANDIDATE\nName: {{ $('My Profile1').first().json.name }}\nLevel: {{ $('My Profile1').first().json.level }}\nSkills: {{ $('My Profile1').first().json.skills }}\nInterests: {{ $('My Profile1').first().json.interests }}\nLives in: Lebanon\n\nJobs\n{{ $json.jobs_text }}\n\nTASK\nEvaluate EVERY job above for this candidate and return one entry per job:\n- id: the number shown in [brackets]\n- score: 0-10 fit for THIS candidate (10 = perfect). Senior / lead / 4+ years roles must score 3 or less.\n- lebanon_ok: true if someone living in Lebanon can realistically apply (Worldwide, Anywhere, EMEA, MENA, Middle East, Lebanon, or no restriction). false if limited to another specific country or region (e.g. \"USA only\", \"UK\", \"Europe only\").\n- reason: ONE short punchy sentence explaining the score\n- matched_skills: candidate skills this job uses (max 4)\n- missing_skills: the 1-3 most important skills the candidate should learn for it",
        "hasOutputParser": true,
        "options": {}
      },
      "id": "ai-recruiter",
      "name": "AI Recruiter",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [140, 260]
    },
    {
      "parameters": {
        "modelName": "models/gemini-3.6-flash",
        "options": {}
      },
      "id": "gemini-chat-model",
      "name": "Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [80, 460],
      "credentials": {
        "googlePalmApi": {
          "id": "REPLACE_ME",
          "name": "Gemini API key"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "jsonSchemaExample": "{\n  \"matches\": [\n    {\n      \"id\": 0,\n      \"score\": 8,\n      \"lebanon_ok\": true,\n      \"reason\": \"Junior React role, open worldwide\",\n      \"matched_skills\": [\"JS\", \"React\"],\n      \"missing_skills\": [\"TypeScript\"]\n    }\n  ]\n}"
      },
      "id": "structured-output-parser",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [260, 460]
    },
    {
      "parameters": {
        "jsCode": "// 🔗 JOIN — attach the AI's score to each original job (matched by id)\nconst jobs = $('Pack Jobs for AI').first().json.jobs;\nconst matches = $input.first().json.output?.matches ?? [];\nconst list = arr => (Array.isArray(arr) ? arr.join(', ') : String(arr ?? ''));\n\nreturn matches\n  .filter(m => jobs[m.id])\n  .map(m => {\n    const job = jobs[m.id];\n    return {\n      json: {\n        date_found: $now.toFormat('yyyy-MM-dd'),\n        score: Number(m.score) || 0,\n        title: job.title,\n        company: job.company,\n        location: job.location,\n        lebanon_ok: m.lebanon_ok === true || m.lebanon_ok === 'true' ? 'YES' : 'NO',\n        reason: m.reason,\n        matched_skills: list(m.matched_skills),\n        missing_skills: list(m.missing_skills),\n        source: job.source,\n        url: job.url,\n      },\n    };\n  })\n  .sort((a, b) => b.json.score - a.json.score);"
      },
      "id": "join-scores-jobs",
      "name": "Join Scores + Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 260]
