      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        3220,
        160
      ]
    },
    {
      "parameters": {
        "jsCode": "// 📧 DIGEST — build one beautiful HTML email from all good matches\nconst p = $('My Profile').first().json;\nconst jobs = $input.all().map(i => i.json);\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst color = s => (s >= 8 ? '#16a34a' : s >= 6 ? '#ca8a04' : '#6b7280');\n\nconst cards = jobs.map(j => `\n  <tr><td style=\"padding:14px 16px;border-bottom:1px solid #eee;font-family:Arial,sans-serif\">\n    <div style=\"font-size:13px;color:#fff;background:${color(j.score)};display:inline-block;padding:2px 8px;border-radius:10px;font-weight:bold\">${esc(j.score)}/10</div>\n    <div style=\"font-size:16px;font-weight:bold;margin:6px 0 2px\">${esc(j.title)}</div>\n    <div style=\"font-size:13px;color:#555\">${esc(j.company)} · ${esc(j.location)}</div>\n    <div style=\"font-size:13px;margin:6px 0\">💡 ${esc(j.reason)}</div>\n    <div style=\"font-size:12px;color:#555\">✅ ${esc(j.matched_skills)}<br>📚 Learn next: ${esc(j.missing_skills)}</div>\n    <a href=\"${esc(j.url)}\" style=\"display:inline-block;margin-top:8px;font-size:13px;color:#ea4b71;font-weight:bold\">View &amp; apply on ${esc(j.source)} →</a>\n  </td></tr>`).join('');\n\nconst html = `\n<div style=\"max-width:620px;margin:auto;border:1px solid #eee;border-radius:12px;overflow:hidden\">\n  <div style=\"background:#1f1f2e;color:#fff;padding:20px 16px;font-family:Arial,sans-serif\">\n    <div style=\"font-size:20px;font-weight:bold\">🎯 Your AI Internship Hunter</div>\n    <div style=\"font-size:13px;opacity:.8\">Hi ${esc(p.name)} — ${jobs.length} match(es) found on ${$now.toFormat('dd LLL yyyy')}</div>\n  </div>\n  <table width=\"100%\" cellspacing=\"0\" cellpadding=\"0\">${cards}</table>\n  <div style=\"padding:12px 16px;font-size:11px;color:#888;font-family:Arial,sans-serif\">\n    Built with n8n + Gemini. Job data from Remotive, Remote OK and Jobicy — always apply via the original link.\n  </div>\n</div>`;\n\nreturn [{ json: { to: p.email, subject: `🎯 ${jobs.length} job match(es) for you — ${$now.toFormat('dd LLL')}`, html } }];\n"
      },
      "id": "107a7091-be14-446b-8b9c-ee35f16d1c81",
