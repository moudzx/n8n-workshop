    {
      "parameters": {
        "jsCode": "// 🧹 SMART FILTER — runs BEFORE the AI to save tokens & rate limits\n// 1) drop broken items  2) remove duplicates (same URL)  3) keep jobs matching my keywords\n// 4) rank by number of keyword hits  5) send only the top N to the AI\nconst profile = $('My Profile').first().json;\nconst keywords = String(profile.keywords || '')\n  .split(',')\n  .map(k => k.trim().toLowerCase())\n  .filter(Boolean);\nconst escapeRe = s => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\nconst patterns = keywords.map(k => ({ k, re: new RegExp(`(^|[^a-z0-9])${escapeRe(k)}([^a-z0-9]|$)`, 'i') }));\n\nconst seen = new Set();\nconst kept = [];\nfor (const item of $input.all()) {\n  const job = item.json;\n  if (!job.url || !job.title || seen.has(job.url)) continue; // broken or duplicate\n  seen.add(job.url);\n  const text = `${job.title} ${job.tags} ${job.description}`;\n  const hits = patterns.filter(p => p.re.test(text)).map(p => p.k);\n  if (hits.length > 0) kept.push({ json: { ...job, keyword_hits: hits.length, keywords_found: hits.join(', ') } });\n}\n\nkept.sort((a, b) => b.json.keyword_hits - a.json.keyword_hits);\nreturn kept.slice(0, Number(profile.max_jobs_for_ai) || 20);\n"
      },
      "id": "e3793364-cdbc-444c-b904-94c350742ecf",
      "name": "Smart Filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        160
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 8
            }
          ]
        }
      },
      "id": "2795bab9-2af9-4e75-affb-3250532a3731",
      "name": "Every Morning 8:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        100,
        400
      ]
    },
    {
      "parameters": {
        "content": "## 🧠 STAGE 2 — AI brain\nPack → Gemini scores every job vs YOUR profile → Join → Good matches (Lebanon-friendly)",
        "height": 110,
        "width": 1080,
        "color": 6
      },
      "id": "b821a6f5-66b9-4c63-bcf2-6849dfb4ac7b",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1640,
        -330
      ]
    },
    {
      "parameters": {
        "jsCode": "// 📦 PACK — turn N job items into ONE item, so the AI scores all jobs in ONE request\n// (free Gemini keys allow ~10 requests/minute — 1 call is faster and never hits the limit)\nconst jobs = $input.all().map((item, index) => ({ id: index, ...item.json }));\nconst jobs_text = jobs\n  .map(j => `[${j.id}] ${j.title} @ ${j.company}\\nLocation: ${j.location} | Source: ${j.source} | Tags: ${j.tags}\\n${j.description}`)\n  .join('\\n\\n---\\n\\n');\nreturn [{ json: { count: jobs.length, jobs, jobs_text } }];\n"
      },
      "id": "4de66ed7-108e-44d8-ba8d-c6877f0cb1e5",
      "name": "Pack Jobs for AI",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        160
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=CANDIDATE\nName: {{ $('My Profile').first().json.name }}\nLevel: {{ $('My Profile').first().json.level }}\nSkills: {{ $('My Profile').first().json.skills }}\nInterests: {{ $('My Profile').first().json.interests }}\nLives in: Lebanon\n\nJOBS ({{ $json.count }} total)\n{{ $json.jobs_text }}\n\nTASK\nEvaluate EVERY job above for this candidate and return one entry per job:\n- id: the number shown in [brackets]\n- score: 0-10 fit for THIS candidate (10 = perfect). Senior / lead / 4+ years roles must score 3 or less.\n- lebanon_ok: true if someone living in Lebanon can realistically apply (Worldwide, Anywhere, EMEA, MENA, Middle East, Lebanon, or no restriction). false if limited to another specific country or region (e.g. \"USA only\", \"UK\", \"Europe only\").\n- reason: ONE short punchy sentence explaining the score\n- matched_skills: candidate skills this job uses (max 4)\n- missing_skills: the 1-3 most important skills the candidate should learn for it",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a brutally honest but kind tech recruiter. You help university Computer Science and Engineering students in Lebanon find internships and junior jobs they can REALLY get. You always answer in valid JSON."
            }
          ]
        }
      },
      "id": "d8c60f28-ba8f-4cff-af3a-b37da6524b5e",
      "name": "AI Recruiter",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.5,
      "position": [
        1920,
        160
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "modelName": "models/gemini-2.5-flash",
        "options": {
          "temperature": 0.2
        }
      },
      "id": "70e31f77-3649-4bcb-af4b-e43d41808f70",
      "name": "Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1880,
        380
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"matches\": [\n    {\n      \"id\": 0,\n      \"score\": 8,\n      \"lebanon_ok\": true,\n      \"reason\": \"Junior React role open worldwide - strong match for your JS skills\",\n      \"matched_skills\": [\n        \"JavaScript\",\n        \"React\"\n      ],\n      \"missing_skills\": [\n        \"TypeScript\",\n        \"Testing\"\n      ]\n    }\n  ]\n}"
      },
      "id": "1836bc27-0dc0-4472-979b-0aceefd48d53",
      "name": "Scores Format (JSON)",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.2,
      "position": [
        2080,
        380
      ]
    },
    {
      "parameters": {
        "jsCode": "// 🔗 JOIN — attach the AI's score to each original job (matched by id)\nconst jobs = $('Pack Jobs for AI').first().json.jobs;\nconst matches = $input.first().json.output?.matches ?? [];\nconst list = arr => (Array.isArray(arr) ? arr.join(', ') : String(arr ?? ''));\n\nreturn matches\n  .filter(m => jobs[m.id])\n  .map(m => {\n    const job = jobs[m.id];\n    return {\n      json: {\n        date_found: $now.toFormat('yyyy-MM-dd'),\n        score: Number(m.score) || 0,\n        title: job.title,\n        company: job.company,\n        location: job.location,\n        lebanon_ok: m.lebanon_ok === true || m.lebanon_ok === 'true' ? 'YES' : 'NO',\n        reason: m.reason,\n        matched_skills: list(m.matched_skills),\n        missing_skills: list(m.missing_skills),\n        source: job.source,\n        url: job.url,\n      },\n    };\n  })\n  .sort((a, b) => b.json.score - a.json.score);\n"
      },
      "id": "43a1979b-f2ca-4f91-a857-32d28393576d",
      "name": "Join Scores + Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2280,
        160
      ]
    },
    {
